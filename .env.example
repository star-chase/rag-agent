# ===== 应用 =====
APP_NAME=rag-agent
ENV=dev
DEBUG=true
API_V1_PREFIX=/api/v1

# ===== 数据库 (PostgreSQL + pgvector) =====
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag_agent

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== JWT =====
JWT_SECRET=please-change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60 * 24

# ===== LLM (OpenAI 兼容接口) =====
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# ===== Embedding (OpenAI 兼容接口) =====
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# ===== 对象存储 (MinIO / S3) =====
# 本机调试用 local（存 uploads/ 目录）；Docker Compose 部署会自动覆盖为 s3
STORAGE_BACKEND=local
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=rag
S3_SECRET_KEY=ragsecret
S3_BUCKET=rag-documents
S3_SECURE=false

# ===== Celery =====
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# 本地无 Redis 调试时设为 true：文档处理同步执行
CELERY_TASK_ALWAYS_EAGER=false

# ===== 检索 / RAG =====
TOP_K=5
RERANK_TOP_K=3
# rrf=融合分数重排（零成本）；llm=LLM 逐条打分重排（更准、耗 token）
RERANK_MODE=rrf
CHUNK_SIZE=800
CHUNK_OVERLAP=100
EMBEDDING_BATCH_SIZE=16

# ===== 限流 =====
RATE_LIMIT_PER_MINUTE=30
